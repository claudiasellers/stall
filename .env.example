# ---------- Stall app (npm run app) ----------
PORT=3000
STALL_DB=data/stall.db
TURSO_DATABASE_URL=            # libsql://<db>-<org>.turso.io (hosted DB; overrides STALL_DB)
TURSO_AUTH_TOKEN=
STALL_PUBLIC_URL=https://stall.example.com
COOKIE_SECURE=true            # true behind HTTPS (required for install + push on phones)
TRUST_PROXY=true              # true behind a reverse proxy / load balancer
STALL_BOOTSTRAP_CODE=         # one-time code for the first (admin) account; then invite-only
HOUSE_TZ=America/New_York     # the group's city: photo unlock at 11am, location drop
STALL_TICK_TOKEN=             # bearer for POST /api/v1/tick (cron pinger)
R2_ACCOUNT_ID=                # Cloudflare R2 for photos (else local disk in STALL_MEDIA_DIR)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
STALL_MEDIA_DIR=data/media

# Shared with the orchestrator. Generate each with: openssl rand -hex 32
STALL_ORCH_TOKEN=
STALL_WEBHOOK_SECRET=
STALL_WEBHOOK_URL=http://127.0.0.1:4100/webhook

# Consensus: built when it has >= VOTE_MIN_UPVOTES upvotes AND >= CONSENSUS_RATIO yes share.
# Admins can approve any time. VOTE_MIN_UPVOTES=0 sends every request straight to the queue.
VOTE_MIN_UPVOTES=3
CONSENSUS_RATIO=0.7
REJECT_MIN_DOWNVOTES=3        # auto-reject once this many downvotes outnumber upvotes; 0 = never

# Phone notifications: generated automatically and stored in the DB if left empty
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Link commits on finished requests, e.g. https://github.com/you/your-product/commit/{sha}
COMMIT_URL_TEMPLATE=

# Product analytics (Mixpanel, server-side only; see docs/ANALYTICS.md). Empty token = off.
MIXPANEL_TOKEN=                # Project settings > Project token (not a secret, but keep it out of the repo)
ANALYTICS_ID_SALT=             # hashes user ids before they leave the server: openssl rand -hex 32. Never change it once set.
MIXPANEL_API_HOST=             # empty = https://api.mixpanel.com; EU data residency: https://api-eu.mixpanel.com
ANALYTICS_DEBUG=false          # true logs each event to stdout

# ---------- Orchestrator (npm run orchestrator) ----------
ORCH_PORT=4100
STALL_APP_URL=http://127.0.0.1:3000
ORCH_DATA_DIR=data/orchestrator
TARGET_REPO=/srv/your-product          # a dedicated clone the lanes build in
BASE_BRANCH=main
GIT_REMOTE=origin                      # empty = local only, no push
WORKER_LANES=4
WORKTREE_SETUP_CMD=npm ci              # run in each fresh worktree
BUILD_CMD=npm run build                # integration lane checks
TEST_CMD=npm test
CHECK_TIMEOUT_SEC=1200
MAX_REWORK=2
POLL_INTERVAL_SEC=30

AGENT=claude                           # or "mock" for a dry run without Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=                          # empty = SDK default
CLAUDE_MAX_TURNS=200
CLAUDE_MAX_BUDGET_USD=                 # optional per-run spend cap
