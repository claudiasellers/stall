# ---------- Stall app (npm run app) ----------
PORT=3000
STALL_DB=data/stall.db
STALL_PUBLIC_URL=https://stall.example.com
COOKIE_SECURE=true            # true behind HTTPS (required for install + push on phones)
TRUST_PROXY=true              # true behind a reverse proxy / load balancer
ALLOW_SIGNUP=true             # first account to sign up becomes admin

# Shared with the orchestrator. Generate each with: openssl rand -hex 32
STALL_ORCH_TOKEN=
STALL_WEBHOOK_SECRET=
STALL_WEBHOOK_URL=http://127.0.0.1:4100/webhook

# Consensus: built when it has >= VOTE_MIN_UPVOTES upvotes AND >= CONSENSUS_RATIO yes share.
# Admins can approve any time. VOTE_MIN_UPVOTES=0 sends every request straight to the queue.
VOTE_MIN_UPVOTES=3
CONSENSUS_RATIO=0.7
REJECT_MIN_DOWNVOTES=3        # auto-reject once this many downvotes outnumber upvotes; 0 = never

# Phone notifications (optional): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Link commits on finished requests, e.g. https://github.com/you/your-product/commit/{sha}
COMMIT_URL_TEMPLATE=

# ---------- Orchestrator (npm run orchestrator) ----------
ORCH_PORT=4100
STALL_APP_URL=http://127.0.0.1:3000
ORCH_DATA_DIR=data/orchestrator
TARGET_REPO=/srv/your-product          # a dedicated clone the lanes build in
BASE_BRANCH=main
GIT_REMOTE=origin                      # empty = local only, no push
WORKER_LANES=4
WORKTREE_SETUP_CMD=npm ci              # run in each fresh worktree
BUILD_CMD=npm run build                # integration lane checks
TEST_CMD=npm test
CHECK_TIMEOUT_SEC=1200
MAX_REWORK=2
POLL_INTERVAL_SEC=30

AGENT=claude                           # or "mock" for a dry run without Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=                          # empty = SDK default
CLAUDE_MAX_TURNS=200
CLAUDE_MAX_BUDGET_USD=                 # optional per-run spend cap
